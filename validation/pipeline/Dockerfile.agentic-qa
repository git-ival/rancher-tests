# Multi-stage image for agentic-qa and test utilities.
FROM golang:1.25-alpine3.22 AS builder

RUN apk add --no-cache git ca-certificates

WORKDIR /src

COPY go.mod go.sum ./
COPY actions/go.mod actions/go.sum ./actions/
COPY interoperability/go.mod interoperability/go.sum ./interoperability/
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags="-s -w" -trimpath \
    -o /agentic-qa ./cmd/agentic-qa

# Install gotestsum for downstream tests.
RUN CGO_ENABLED=0 go install gotest.tools/gotestsum@v1.13.0

FROM alpine:3.22

RUN apk add --no-cache \
    bash \
    curl \
    git \
    ca-certificates \
    jq

COPY --from=builder /agentic-qa /usr/local/bin/agentic-qa

COPY --from=builder /go/bin/gotestsum /usr/local/bin/gotestsum

# Install the latest stable kubectl.
RUN KUBECTL_VERSION="$(curl -sL https://dl.k8s.io/release/stable.txt)" && \
    curl -sLO "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl" && \
    chmod +x kubectl && mv kubectl /usr/local/bin/

WORKDIR /workspace

ENTRYPOINT ["agentic-qa"]
