#!/usr/bin/env groovy

/**
 * Jenkinsfile.agentic-qa
 *
 * Agentic QA Pipeline — AI-driven test identification, execution,
 * analysis, and automated remediation for rancher/rancher changes.
 *
 * ──────────────────────────────────────────────────────────────────
 * PARAMETER OWNERSHIP
 * ──────────────────────────────────────────────────────────────────
 * ALL parameters are defined exclusively in qa-agentic-qa-pipeline.yml
 * (jenkins-job-builder). This file contains NO parameters{} block.
 *
 * TRIGGER: MANUAL ONLY — use "Build with Parameters" in the Jenkins UI.
 *
 * ──────────────────────────────────────────────────────────────────
 * CONTAINER BUILD PATTERN
 * ──────────────────────────────────────────────────────────────────
 * Matches the pattern used by Jenkinsfile.individual.e2e:
 *   1. Checkout — GitSCM with CleanCheckout extension
 *   2. Build Image — `docker build` from Dockerfile.agentic-qa
 *   3. Run steps — `docker run --rm --env-file ...` per stage
 *   4. Cleanup — `docker rmi -f` in post { always }
 *
 * ──────────────────────────────────────────────────────────────────
 * CREDENTIAL HANDLING
 * ──────────────────────────────────────────────────────────────────
 * Text credentials are written to an env file (.agentic_env) that is
 * passed to every `docker run` invocation via --env-file.
 * The Google SA JSON file (GOOGLE_APPLICATION_CREDENTIALS) is mounted
 * into the container at /run/google_creds.json.
 * Neither the env file nor the credential paths are shell-interpolated
 * into command arguments; they are written by Groovy and referenced
 * by fixed workspace-relative paths.
 *
 * ──────────────────────────────────────────────────────────────────
 * SHELL INJECTION HARDENING
 * ──────────────────────────────────────────────────────────────────
 * All user-supplied string parameters are validated against strict
 * allowlist regexes before being written to the env file or used in
 * any shell call. The env file approach keeps secrets out of process
 * arguments entirely (not visible in `ps` output).
 *
 * Required Credentials (Jenkins Credential Store):
 *   github-api-token        Secret text — GitHub PAT
 *   qase-api-token          Secret text — Qase API token
 *   claude-api-key          Secret text — Anthropic API key
 *   google-vertex-sa-key    Secret file — Google SA JSON key
 *   github-copilot-token    Secret text — Copilot token
 *   github-mcp-token        Secret text — GitHub MCP token (optional)
 */

// ── Allowlist patterns — validated before touching any shell ──────
@groovy.transform.Field
static final Map<String, java.util.regex.Pattern> PAT = [
    PR_NUMBER:     ~/^\d{1,10}$/,
    REPO:          ~/^[A-Za-z0-9_.-]{1,100}\/[A-Za-z0-9_.-]{1,100}$/,
    HTTPS_GIT_URL: ~/^https:\/\/github\.com\/[A-Za-z0-9_.-]{1,100}\/[A-Za-z0-9_.-]{1,100}(\.git)?$/,
    GIT_BRANCH:    ~/^[A-Za-z0-9][A-Za-z0-9_.\/\-]{0,100}$/,
    MODEL_ID:      ~/^claude-[a-z0-9\-]{2,60}$/,
    GCP_PROJECT:   ~/^[a-z][a-z0-9\-]{4,28}[a-z0-9]$/,
    GCP_LOCATION:  ~/^[a-z]{2,20}(-[a-z]{2,20}[0-9]?)?$/,
    TIMEOUT:       ~/^\d{1,4}[smh]$/,
    MAX_RERUNS:    ~/^([0-9]|10)$/,
    QASE_PROJECT:  ~/^[A-Z0-9_]{2,10}$/,
    QASE_RUN_NAME: ~/^[A-Za-z0-9 ._:#\/\-]{0,200}$/,
    MCP_URL:       ~/^https?:\/\/[A-Za-z0-9_.\-]+(:\d{1,5})?\/(mcp|sse)$/,
]

// Unique image name for this build — avoids conflicts on shared nodes
@groovy.transform.Field
static final String IMAGE_BASE = 'rancher-agentic-qa'

def AGENTIC_IMAGE = ''
def PIPELINE_RESULT = [:]

// ── Fixed workspace-relative paths (never user-controlled) ────────
def ENV_FILE      = '.agentic_env'              // docker --env-file
def GCP_CREDS     = '.google_creds.json'        // SA key copy in workspace
def CTX_FILE      = '.agentic_context.txt'      // ADDITIONAL_CONTEXT staging
def STATE_FILE    = 'pipeline_state.json'        // resource tracking for cleanup
def TRIGGER_MAP   = 'jenkins_trigger_mapping.json' // written from JENKINS_TRIGGER_MAPPING param

pipeline {
    // Same agent type as Jenkinsfile.individual.e2e — any Docker-capable node.
    agent any

    options {
        timeout(time: 2, unit: 'HOURS')
        timestamps()
        ansiColor('xterm')
        buildDiscarder(logRotator(numToKeepStr: '30'))
        disableConcurrentBuilds()
    }

    // NO parameters{} block — defined solely in qa-agentic-qa-pipeline.yml.

    stages {

        ////////////////////////////////////////////////////////////////////////
        // STAGE 0: CHECKOUT
        // Explicit GitSCM checkout — matches Jenkinsfile.individual.e2e pattern.
        // The pipeline-scm checkout delivers the Jenkinsfile; this checkout
        // ensures the correct TESTS_BRANCH is present for the Docker build.
        ////////////////////////////////////////////////////////////////////////
        stage('Checkout') {
            steps {
                script {
                    // Validate SCM parameters before touching Git
                    if (!params.TESTS_REPO_URL?.trim() ||
                        !params.TESTS_REPO_URL.matches(PAT.HTTPS_GIT_URL))
                        error("TESTS_REPO_URL must be an HTTPS GitHub URL. " +
                              "Got: '${params.TESTS_REPO_URL?.take(80)}'")

                    def branch = params.TESTS_BRANCH?.trim() ?: 'main'
                    if (!branch.matches(PAT.GIT_BRANCH))
                        error("TESTS_BRANCH contains invalid characters. " +
                              "Got: '${branch.take(40)}'")

                    deleteDir()
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: "*/${branch}"]],
                        extensions: [[$class: 'CleanCheckout']],
                        userRemoteConfigs: [[url: params.TESTS_REPO_URL]]
                    ])

                    echo "Checked out ${params.TESTS_REPO_URL} @ ${branch}"
                }
            }
        }

        ////////////////////////////////////////////////////////////////////////
        // STAGE 1: VALIDATE PARAMETERS & WRITE CREDENTIAL FILES
        // Validates all user parameters with strict regex allowlists.
        // Writes the env file and stages credentials — no shell interpolation.
        ////////////////////////////////////////////////////////////////////////
        stage('Setup') {
            steps {
                // Bind all credentials in a single withCredentials block.
                // Text credentials → env vars written to .agentic_env.
                // File credential → copied to workspace as .google_creds.json.
                withCredentials([
                    string(credentialsId: 'github-api-token',     variable: 'GITHUB_TOKEN'),
                    string(credentialsId: 'qase-api-token',       variable: 'QASE_API_TOKEN'),
                    string(credentialsId: 'claude-api-key',       variable: 'CLAUDE_API_KEY'),
                    file(  credentialsId: 'google-vertex-sa-key', variable: 'GOOGLE_SA_FILE'),
                    string(credentialsId: 'github-copilot-token', variable: 'COPILOT_TOKEN'),
                    string(credentialsId: 'github-mcp-token',     variable: 'GITHUB_MCP_TOKEN'),
                ]) {
                    script {
                        // ── Validate all parameters ───────────────────────────

                        def prRaw = params.RANCHER_PR_NUMBER?.trim() ?: ''
                        if (!prRaw.matches(PAT.PR_NUMBER))
                            error("RANCHER_PR_NUMBER must be 1-10 digits. Got: '${prRaw.take(30)}'")

                        if (!params.RANCHER_REPO.matches(PAT.REPO))
                            error("RANCHER_REPO must match owner/repo. Got: '${params.RANCHER_REPO.take(50)}'")

                        if (params.LLM_PROVIDER == 'vertex-ai') {
                            if (!params.VERTEX_PROJECT_ID?.trim())
                                error('VERTEX_PROJECT_ID is required when LLM_PROVIDER=vertex-ai')
                            if (!params.VERTEX_PROJECT_ID.matches(PAT.GCP_PROJECT))
                                error("VERTEX_PROJECT_ID invalid GCP project ID. Got: '${params.VERTEX_PROJECT_ID.take(40)}'")
                            if (!params.VERTEX_LOCATION.matches(PAT.GCP_LOCATION))
                                error("VERTEX_LOCATION invalid. Got: '${params.VERTEX_LOCATION.take(40)}'")
                        }

                        if (!params.SONNET_MODEL.matches(PAT.MODEL_ID))
                            error("SONNET_MODEL invalid. Got: '${params.SONNET_MODEL.take(40)}'")
                        if (!params.HAIKU_MODEL.matches(PAT.MODEL_ID))
                            error("HAIKU_MODEL invalid. Got: '${params.HAIKU_MODEL.take(40)}'")

                        def runName = params.QASE_TEST_RUN_NAME?.trim() ?: ''
                        if (runName && !runName.matches(PAT.QASE_RUN_NAME))
                            error('QASE_TEST_RUN_NAME has disallowed characters')
                        def resolvedRunName = runName ?:
                            "Agentic QA - PR-${prRaw} - ${new Date().format('yyyy-MM-dd')}"

                        def mcpUrl = params.QASE_MCP_SERVER_URL?.trim() ?: ''
                        if (mcpUrl && !mcpUrl.matches(PAT.MCP_URL))
                            error("QASE_MCP_SERVER_URL must be http(s)://host[:port]/(mcp|sse). Got: '${mcpUrl.take(100)}'")

                        if (!params.TEST_TIMEOUT.matches(PAT.TIMEOUT))
                            error("TEST_TIMEOUT invalid. Got: '${params.TEST_TIMEOUT.take(20)}'")
                        if (!params.MAX_RERUNS.matches(PAT.MAX_RERUNS))
                            error("MAX_RERUNS must be 0-10. Got: '${params.MAX_RERUNS.take(5)}'")

                        // ── Stage ADDITIONAL_CONTEXT to file (never a shell arg) ──
                        writeFile file: CTX_FILE, text: params.ADDITIONAL_CONTEXT ?: ''

                        // ── Validate and stage JENKINS_TRIGGER_MAPPING ────────────
                        // The mapping JSON is supplied as a parameter (not committed
                        // to the repo) because it contains internal Jenkins job names
                        // and infrastructure details. Validate it is non-empty and
                        // parses as valid JSON before writing to the workspace.
                        def triggerMapRaw = params.JENKINS_TRIGGER_MAPPING?.trim() ?: ''
                        if (!triggerMapRaw) {
                            error('JENKINS_TRIGGER_MAPPING is required and must not be empty. ' +
                                  'Paste the contents of jenkins_trigger_mapping.json into the parameter.')
                        }
                        try {
                            new groovy.json.JsonSlurper().parseText(triggerMapRaw)
                        } catch (jsonEx) {
                            error("JENKINS_TRIGGER_MAPPING is not valid JSON: ${jsonEx.message}")
                        }
                        // Write to workspace — content is NEVER echoed or logged.
                        writeFile file: TRIGGER_MAP, text: triggerMapRaw
                        sh "chmod 600 '${TRIGGER_MAP}'"

                        // ── Write Google SA key to workspace for container mount ──
                        // GOOGLE_SA_FILE is an agent-local path from Jenkins credentials.
                        // sh copy via absolute path — no secret value touches a shell arg.
                        sh "cp '${GOOGLE_SA_FILE}' '${GCP_CREDS}'"

                        // ── Initialize pipeline_state.json ────────────────────────
                        writeJSON file: STATE_FILE, json: [
                            qase_runs: [], qase_defects: [],
                            github_issues: [], github_prs: [],
                        ]

                        // ── Write env file for docker run --env-file ──────────────
                        // Credentials are written here by Groovy — never interpolated
                        // into shell command strings. The file is chmod 600 immediately.
                        //
                        // SECURITY: All values written are either:
                        //   a) Validated against strict regex patterns (above), OR
                        //   b) Opaque credential tokens from Jenkins (not user-supplied)
                        //
                        // The docker run commands reference this file by its fixed path;
                        // no credential value is ever in a shell argument.
                        def envLines = []

                        // Credentials (from Jenkins credential store)
                        envLines += "GITHUB_TOKEN=${GITHUB_TOKEN}"
                        envLines += "QASE_API_TOKEN=${QASE_API_TOKEN}"
                        envLines += "CLAUDE_API_KEY=${CLAUDE_API_KEY}"
                        envLines += "GOOGLE_APPLICATION_CREDENTIALS=/run/google_creds.json"
                        envLines += "COPILOT_TOKEN=${COPILOT_TOKEN}"
                        envLines += "GITHUB_MCP_TOKEN=${GITHUB_MCP_TOKEN}"

                        // Validated parameters
                        envLines += "AGENTIC_PR_NUMBER=${prRaw}"
                        envLines += "AGENTIC_REPO=${params.RANCHER_REPO}"
                        envLines += "AGENTIC_PROVIDER=${params.LLM_PROVIDER}"
                        envLines += "AGENTIC_VERTEX_PROJECT=${params.VERTEX_PROJECT_ID ?: ''}"
                        envLines += "AGENTIC_VERTEX_LOCATION=${params.VERTEX_LOCATION}"
                        envLines += "AGENTIC_SONNET_MODEL=${params.SONNET_MODEL}"
                        envLines += "AGENTIC_HAIKU_MODEL=${params.HAIKU_MODEL}"
                        envLines += "AGENTIC_QASE_PROJECT=${params.QASE_PROJECT}"
                        envLines += "AGENTIC_QASE_RUN_NAME=${resolvedRunName}"
                        envLines += "AGENTIC_MCP_URL=${mcpUrl}"
                        envLines += "AGENTIC_TEST_TIMEOUT=${params.TEST_TIMEOUT}"
                        envLines += "AGENTIC_MAX_RERUNS=${params.MAX_RERUNS}"
                        envLines += "AGENTIC_AUTO_TRIGGER=${params.AUTO_TRIGGER_TESTS}"
                        envLines += "AGENTIC_AUTO_ISSUES=${params.AUTO_CREATE_ISSUES}"
                        envLines += "AGENTIC_AUTO_PRS=${params.AUTO_CREATE_PRS}"
                        envLines += "AGENTIC_USE_COPILOT=${params.USE_COPILOT_FOR_FIXES}"
                        envLines += "AGENTIC_DRY_RUN=${params.DRY_RUN}"
                        envLines += "AGENTIC_CLEANUP_MODE=${params.CLEANUP_MODE}"

                        writeFile file: ENV_FILE, text: envLines.join('\n') + '\n'
                        sh "chmod 600 '${ENV_FILE}' '${GCP_CREDS}'"

                        echo """=== Agentic QA Pipeline ===
PR:        ${params.RANCHER_REPO}#${prRaw}
Provider:  ${params.LLM_PROVIDER}
Qase:      ${params.QASE_PROJECT}
MCP:       ${mcpUrl ?: '(not configured)'}
Dry run:   ${params.DRY_RUN}
Cleanup:   ${params.CLEANUP_MODE}
All inputs validated."""
                    }
                }
            }
        }

        ////////////////////////////////////////////////////////////////////////
        // STAGE 2: BUILD CONTAINER IMAGE
        // Matches the `docker build` pattern from Jenkinsfile.individual.e2e.
        // Build context is the repo root (WORKSPACE) so COPY . . in the
        // Dockerfile picks up the full source tree including go.mod/go.sum.
        ////////////////////////////////////////////////////////////////////////
        stage('Build Container') {
            steps {
                script {
                    AGENTIC_IMAGE = "${IMAGE_BASE}-${env.BUILD_NUMBER}"
                    currentBuild.displayName = "#${env.BUILD_NUMBER} - ${params.RANCHER_REPO}#${params.RANCHER_PR_NUMBER}"

                    sh """
                        docker build \\
                            --no-cache \\
                            --platform linux/amd64 \\
                            -t ${AGENTIC_IMAGE} \\
                            -f validation/pipeline/Dockerfile.agentic-qa \\
                            .
                    """

                    echo "Built image: ${AGENTIC_IMAGE}"

                    // Smoke-test: verify the binary exists and responds
                    sh "docker run --rm ${AGENTIC_IMAGE} --help > /dev/null"
                }
            }
        }

        ////////////////////////////////////////////////////////////////////////
        // STAGE 3: VALIDATE CREDENTIALS
        ////////////////////////////////////////////////////////////////////////
        stage('Validate Credentials') {
            steps {
                script {
                    sh """
                        docker run --rm \\
                            --platform linux/amd64 \\
                            --env-file '${ENV_FILE}' \\
                            -v "\${PWD}/${GCP_CREDS}:/run/google_creds.json:ro" \\
                            ${AGENTIC_IMAGE} \\
                            validate \\
                                --provider       "\${AGENTIC_PROVIDER:-vertex-ai}" \\
                                --vertex-project "\${AGENTIC_VERTEX_PROJECT}" \\
                                --vertex-location "\${AGENTIC_VERTEX_LOCATION}" \\
                                --qase-project   "\${AGENTIC_QASE_PROJECT}"
                    """
                }
            }
        }

        ////////////////////////////////////////////////////////////////////////
        // HELPER: shared docker run wrapper
        // All steps call _run() to ensure consistent flags.
        ////////////////////////////////////////////////////////////////////////

        ////////////////////////////////////////////////////////////////////////
        // STEP 1: IDENTIFY TESTS                                      [Haiku]
        ////////////////////////////////////////////////////////////////////////
        stage('Step 1: Identify Tests') {
            steps {
                script {
                    sh """
                        docker run --rm \\
                            --platform linux/amd64 \\
                            --env-file '${ENV_FILE}' \\
                            -v "\${PWD}/${GCP_CREDS}:/run/google_creds.json:ro" \\
                            -v "\${PWD}:/workspace" \\
                            -w /workspace \\
                            ${AGENTIC_IMAGE} \\
                            identify \\
                                --provider          "\${AGENTIC_PROVIDER}" \\
                                --vertex-project    "\${AGENTIC_VERTEX_PROJECT}" \\
                                --vertex-location   "\${AGENTIC_VERTEX_LOCATION}" \\
                                --haiku-model       "\${AGENTIC_HAIKU_MODEL}" \\
                                --qase-project      "\${AGENTIC_QASE_PROJECT}" \\
                                --pr-number         "\${AGENTIC_PR_NUMBER}" \\
                                --repo              "\${AGENTIC_REPO}" \\
                                --mapping-file      /workspace/feature_test_mapping.json \\
                                --output-file       /workspace/identified_tests.json \\
                                --additional-context-file /workspace/${CTX_FILE}
                    """

                    if (fileExists('identified_tests.json')) {
                        def d = readJSON file: 'identified_tests.json'
                        PIPELINE_RESULT['identified_tests'] = d
                        echo "Tests: ${d.tests?.size() ?: 0} | Areas: ${d.feature_areas?.join(', ') ?: '(none)'}"
                        if (!d.tests) { currentBuild.result = 'UNSTABLE' }
                    }
                }
            }
        }

        ////////////////////////////////////////////////////////////////////////
        // STEP 2: TRIGGER TESTS                                  [Direct API]
        ////////////////////////////////////////////////////////////////////////
        stage('Step 2: Trigger Tests') {
            when {
                allOf {
                    expression { params.AUTO_TRIGGER_TESTS }
                    expression { !params.DRY_RUN }
                    expression { PIPELINE_RESULT['identified_tests']?.tests?.size() > 0 }
                }
            }
            steps {
                script {
                    sh """
                        docker run --rm \\
                            --platform linux/amd64 \\
                            --env-file '${ENV_FILE}' \\
                            -v "\${PWD}/${GCP_CREDS}:/run/google_creds.json:ro" \\
                            -v "\${PWD}:/workspace" \\
                            -w /workspace \\
                            ${AGENTIC_IMAGE} \\
                            trigger \\
                                --provider          "\${AGENTIC_PROVIDER}" \\
                                --vertex-project    "\${AGENTIC_VERTEX_PROJECT}" \\
                                --vertex-location   "\${AGENTIC_VERTEX_LOCATION}" \\
                                --qase-project      "\${AGENTIC_QASE_PROJECT}" \\
                                --mcp-url           "\${AGENTIC_MCP_URL}" \\
                                --state-file        /workspace/${STATE_FILE} \\
                                --identified-tests  /workspace/identified_tests.json \\
                                --trigger-mapping   /workspace/jenkins_trigger_mapping.json \\
                                --qase-run-name     "\${AGENTIC_QASE_RUN_NAME}" \\
                                --test-timeout      "\${AGENTIC_TEST_TIMEOUT}" \\
                                --pr-number         "\${AGENTIC_PR_NUMBER}" \\
                                --repo              "\${AGENTIC_REPO}" \\
                                --output-file       /workspace/triggered_jobs.json \\
                                --jenkins-url       "${env.JENKINS_URL}"
                    """

                    if (fileExists('triggered_jobs.json')) {
                        def d = readJSON file: 'triggered_jobs.json'
                        PIPELINE_RESULT['triggered_jobs'] = d
                        echo "Qase run: ${d.qase_run_id ?: 'N/A'} | Jobs: ${d.jobs?.size() ?: 0}"
                    }
                }
            }
        }

        ////////////////////////////////////////////////////////////////////////
        // STEP 2b: WAIT FOR TEST COMPLETION
        ////////////////////////////////////////////////////////////////////////
        stage('Step 2b: Wait for Tests') {
            when {
                allOf {
                    expression { params.AUTO_TRIGGER_TESTS }
                    expression { !params.DRY_RUN }
                    expression { PIPELINE_RESULT['triggered_jobs']?.jobs?.size() > 0 }
                }
            }
            steps {
                script {
                    timeout(time: 360, unit: 'MINUTES') {
                        sh """
                            docker run --rm \\
                                --platform linux/amd64 \\
                                --env-file '${ENV_FILE}' \\
                                -v "\${PWD}/${GCP_CREDS}:/run/google_creds.json:ro" \\
                                -v "\${PWD}:/workspace" \\
                                -w /workspace \\
                                ${AGENTIC_IMAGE} \\
                                wait \\
                                    --qase-project   "\${AGENTIC_QASE_PROJECT}" \\
                                    --mcp-url        "\${AGENTIC_MCP_URL}" \\
                                    --triggered-jobs /workspace/triggered_jobs.json \\
                                    --poll-interval  120 \\
                                    --output-file    /workspace/completed_jobs.json \\
                                    --jenkins-url    "${env.JENKINS_URL}"
                        """
                    }

                    if (fileExists('completed_jobs.json')) {
                        def d = readJSON file: 'completed_jobs.json'
                        PIPELINE_RESULT['completed_jobs'] = d
                        echo "OK: ${d.completed?.size() ?: 0} | Failed: ${d.failed?.size() ?: 0}"
                    }
                }
            }
        }

        ////////////////////////////////////////////////////////////////////////
        // STEP 3: ANALYZE RESULTS (TRIAGE)                          [Sonnet]
        ////////////////////////////////////////////////////////////////////////
        stage('Step 3: Analyze Results') {
            when {
                expression {
                    def c = PIPELINE_RESULT['completed_jobs']
                    return (c?.failed?.size() > 0 || c?.completed?.size() > 0)
                }
            }
            steps {
                script {
                    def rc = sh(script: """
                        docker run --rm \\
                            --platform linux/amd64 \\
                            --env-file '${ENV_FILE}' \\
                            -v "\${PWD}/${GCP_CREDS}:/run/google_creds.json:ro" \\
                            -v "\${PWD}:/workspace" \\
                            -w /workspace \\
                            ${AGENTIC_IMAGE} \\
                            analyze \\
                                --provider              "\${AGENTIC_PROVIDER}" \\
                                --vertex-project        "\${AGENTIC_VERTEX_PROJECT}" \\
                                --vertex-location       "\${AGENTIC_VERTEX_LOCATION}" \\
                                --sonnet-model          "\${AGENTIC_SONNET_MODEL}" \\
                                --qase-project          "\${AGENTIC_QASE_PROJECT}" \\
                                --mcp-url               "\${AGENTIC_MCP_URL}" \\
                                --completed-jobs        /workspace/completed_jobs.json \\
                                --triage-framework      /workspace/triage_framework.json \\
                                --feature-mapping       /workspace/feature_test_mapping.json \\
                                --output-file           /workspace/triage_results.json \\
                                --additional-context-file /workspace/${CTX_FILE}
                    """, returnStatus: true)

                    if (rc != 0) echo "WARNING: Triage had errors (exit ${rc})"

                    if (fileExists('triage_results.json')) {
                        def d = readJSON file: 'triage_results.json'
                        PIPELINE_RESULT['triage'] = d
                        echo "Product: ${d.product_defects?.size() ?: 0} | Test: ${d.test_defects?.size() ?: 0} | Config: ${d.config_issues?.size() ?: 0} | Pass: ${d.passed?.size() ?: 0}"
                    }
                }
            }
        }

        ////////////////////////////////////////////////////////////////////////
        // STEP 4: HANDLE DEFECTS                            [Sonnet + Haiku]
        ////////////////////////////////////////////////////////////////////////
        stage('Step 4: Handle Defects') {
            when {
                expression {
                    def t = PIPELINE_RESULT['triage']
                    return (t?.product_defects?.size() > 0 || t?.test_defects?.size() > 0)
                }
            }
            steps {
                script {
                    sh """
                        docker run --rm \\
                            --platform linux/amd64 \\
                            --env-file '${ENV_FILE}' \\
                            -v "\${PWD}/${GCP_CREDS}:/run/google_creds.json:ro" \\
                            -v "\${PWD}:/workspace" \\
                            -w /workspace \\
                            ${AGENTIC_IMAGE} \\
                            defects \\
                                --provider          "\${AGENTIC_PROVIDER}" \\
                                --vertex-project    "\${AGENTIC_VERTEX_PROJECT}" \\
                                --vertex-location   "\${AGENTIC_VERTEX_LOCATION}" \\
                                --sonnet-model      "\${AGENTIC_SONNET_MODEL}" \\
                                --haiku-model       "\${AGENTIC_HAIKU_MODEL}" \\
                                --qase-project      "\${AGENTIC_QASE_PROJECT}" \\
                                --mcp-url           "\${AGENTIC_MCP_URL}" \\
                                --state-file        /workspace/${STATE_FILE} \\
                                --dry-run="\${AGENTIC_DRY_RUN}" \\
                                --triage-results    /workspace/triage_results.json \\
                                --product-repo      "\${AGENTIC_REPO}" \\
                                --tests-repo        "rancher/tests" \\
                                --pr-number         "\${AGENTIC_PR_NUMBER}" \\
                                --auto-create-issues="\${AGENTIC_AUTO_ISSUES}" \\
                                --auto-create-prs="\${AGENTIC_AUTO_PRS}" \\
                                --use-copilot="\${AGENTIC_USE_COPILOT}" \\
                                --output-file       /workspace/defect_actions.json
                    """

                    if (fileExists('defect_actions.json')) {
                        def d = readJSON file: 'defect_actions.json'
                        PIPELINE_RESULT['defect_actions'] = d
                        echo "Issues: ${d.issues_created?.size() ?: 0} | PRs: ${d.prs_opened?.size() ?: 0} | Copilot: ${d.copilot_assignments?.size() ?: 0}"
                    }
                }
            }
        }

        ////////////////////////////////////////////////////////////////////////
        // STEP 5: HANDLE CONFIG FAILURES                    [Haiku + Sonnet]
        ////////////////////////////////////////////////////////////////////////
        stage('Step 5: Handle Config Failures') {
            when {
                expression { PIPELINE_RESULT['triage']?.config_issues?.size() > 0 }
            }
            steps {
                script {
                    sh """
                        docker run --rm \\
                            --platform linux/amd64 \\
                            --env-file '${ENV_FILE}' \\
                            -v "\${PWD}/${GCP_CREDS}:/run/google_creds.json:ro" \\
                            -v "\${PWD}:/workspace" \\
                            -w /workspace \\
                            ${AGENTIC_IMAGE} \\
                            config-failures \\
                                --provider          "\${AGENTIC_PROVIDER}" \\
                                --vertex-project    "\${AGENTIC_VERTEX_PROJECT}" \\
                                --vertex-location   "\${AGENTIC_VERTEX_LOCATION}" \\
                                --sonnet-model      "\${AGENTIC_SONNET_MODEL}" \\
                                --haiku-model       "\${AGENTIC_HAIKU_MODEL}" \\
                                --qase-project      "\${AGENTIC_QASE_PROJECT}" \\
                                --mcp-url           "\${AGENTIC_MCP_URL}" \\
                                --state-file        /workspace/${STATE_FILE} \\
                                --dry-run="\${AGENTIC_DRY_RUN}" \\
                                --triage-results    /workspace/triage_results.json \\
                                --trigger-mapping   /workspace/jenkins_trigger_mapping.json \\
                                --max-reruns        "\${AGENTIC_MAX_RERUNS}" \\
                                --tests-repo        "rancher/tests" \\
                                --auto-create-prs="\${AGENTIC_AUTO_PRS}" \\
                                --output-file       /workspace/config_actions.json \\
                                --jenkins-url       "${env.JENKINS_URL}"
                    """

                    if (fileExists('config_actions.json')) {
                        def d = readJSON file: 'config_actions.json'
                        PIPELINE_RESULT['config_actions'] = d
                        echo "Reruns: ${d.reruns?.size() ?: 0} | Guards: ${d.guards?.size() ?: 0} | PRs: ${d.prs_opened?.size() ?: 0}"
                    }
                }
            }
        }

        ////////////////////////////////////////////////////////////////////////
        // STEP 6: CLEANUP (when CLEANUP_MODE=true)
        ////////////////////////////////////////////////////////////////////////
        stage('Step 6: Cleanup') {
            when { expression { params.CLEANUP_MODE } }
            steps {
                script {
                    def rc = sh(script: """
                        docker run --rm \\
                            --platform linux/amd64 \\
                            --env-file '${ENV_FILE}' \\
                            -v "\${PWD}/${GCP_CREDS}:/run/google_creds.json:ro" \\
                            -v "\${PWD}:/workspace" \\
                            -w /workspace \\
                            ${AGENTIC_IMAGE} \\
                            cleanup \\
                                --qase-project "\${AGENTIC_QASE_PROJECT}" \\
                                --mcp-url      "\${AGENTIC_MCP_URL}" \\
                                --state-file   /workspace/${STATE_FILE} \\
                                --dry-run="\${AGENTIC_DRY_RUN}" \\
                                --output-file  /workspace/cleanup_result.json
                    """, returnStatus: true)

                    if (rc != 0) echo "WARNING: Cleanup had errors (exit ${rc})"

                    if (fileExists('cleanup_result.json')) {
                        def d = readJSON file: 'cleanup_result.json'
                        PIPELINE_RESULT['cleanup'] = d
                        echo "Runs deleted: ${d.qase_runs_deleted ?: 0} | Defects deleted: ${d.qase_defects_deleted ?: 0} | Issues closed: ${d.github_issues_closed ?: 0} | PRs closed: ${d.github_prs_closed ?: 0}"
                    }
                }
            }
        }

        ////////////////////////////////////////////////////////////////////////
        // SUMMARY
        ////////////////////////////////////////////////////////////////////////
        stage('Summary') {
            steps {
                script {
                    echo buildSummary(PIPELINE_RESULT)
                    writeJSON file: 'pipeline_summary.json',
                              json: PIPELINE_RESULT, pretty: 2
                }
            }
        }
    }

    post {
        always {
            // Remove the built image
            script {
                if (AGENTIC_IMAGE) {
                    sh "docker rmi -f ${AGENTIC_IMAGE} || true"
                }
            }
            // Archive outputs; delete sensitive files
            archiveArtifacts artifacts: 'pipeline_summary.json, cleanup_result.json',
                             allowEmptyArchive: true
            // Remove all sensitive staging files from workspace.
            // TRIGGER_MAP contains internal job names — must not persist.
            sh """
                rm -f '${ENV_FILE}' '${GCP_CREDS}' '${CTX_FILE}' '${TRIGGER_MAP}' || true
            """
        }
    }
}

// ── Helpers ───────────────────────────────────────────────────────

def buildSummary(Map r) {
    def sep = '=' * 70
    def s = new StringBuilder()
    s << sep << '\n  AGENTIC QA PIPELINE SUMMARY\n'
    s << "  PR: ${params.RANCHER_REPO}#${params.RANCHER_PR_NUMBER}\n" << sep << '\n\n'

    def t = r.identified_tests
    s << "1. Tests identified: ${t?.tests?.size() ?: 0}  (${t?.feature_areas?.join(', ') ?: '-'})\n"

    def j = r.triggered_jobs
    s << "2. Jobs triggered: ${j?.jobs?.size() ?: 0}  Qase run: ${j?.qase_run_id ?: '-'}\n"

    def tr = r.triage
    s << "3. Product: ${tr?.product_defects?.size() ?: 0}  Test: ${tr?.test_defects?.size() ?: 0}  Config: ${tr?.config_issues?.size() ?: 0}  Pass: ${tr?.passed?.size() ?: 0}\n"

    def da = r.defect_actions
    s << "4. Issues: ${da?.issues_created?.size() ?: 0}  PRs: ${da?.prs_opened?.size() ?: 0}  Copilot: ${da?.copilot_assignments?.size() ?: 0}\n"

    def ca = r.config_actions
    s << "5. Reruns: ${ca?.reruns?.size() ?: 0}  Guards: ${ca?.guards?.size() ?: 0}  PRs: ${ca?.prs_opened?.size() ?: 0}\n"

    def cl = r.cleanup
    if (cl) s << "6. Cleanup: runs=${cl.qase_runs_deleted ?: 0} defects=${cl.qase_defects_deleted ?: 0} issues=${cl.github_issues_closed ?: 0} prs=${cl.github_prs_closed ?: 0}\n"

    s << '\n' << sep
    return s.toString()
}
